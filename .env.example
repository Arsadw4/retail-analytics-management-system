# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file -- it is already listed in .gitignore.

FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-key-before-startup

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=retail_app_user
MYSQL_PASSWORD=change-this-and-rotate-the-real-db-password
MYSQL_ROOT_PASSWORD=replace-this-before-startup
MYSQL_DB=enterprise_retail_management

# Connection pool tuning (defaults are fine for most deployments)
DB_POOL_MAX_CONNECTIONS=20
DB_POOL_MIN_CACHED=2
DB_POOL_MAX_CACHED=10

# Use redis://localhost:6379/0 in production so rate limits are
# shared across multiple worker processes.
RATELIMIT_STORAGE_URI=memory://

LOG_DIR=logs

# Email (Phase 4: invoice emailing) -- leave blank to disable emailing
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=billing@example.com

# Phase 9: security / backup / performance
SESSION_TIMEOUT_MINUTES=60
BACKUP_DIR=backups
MYSQL_CLIENT_BIN_DIR=
MFA_ISSUER_NAME=Retail Analytics System
